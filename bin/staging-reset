#!/usr/bin/env bash
# Volta `staging` para o estado de `main`, descartando tudo que foi enviado
# com bin/staging-push.
#
# Uso:
#   bin/staging-reset        # mostra o que será descartado e pede confirmação
#   bin/staging-reset --yes  # sem confirmação (para scripts e agentes)
set -euo pipefail

REMOTE=origin

fail() { echo "staging-reset: $*" >&2; exit 1; }

yes=false
case "${1:-}" in
  --yes|-y) yes=true ;;
  "") ;;
  *) fail "opção desconhecida: $1" ;;
esac

# Refspec explícito: funciona também em clones --single-branch.
git fetch --quiet "$REMOTE" "+refs/heads/main:refs/remotes/$REMOTE/main"
staging_sha=""
if git fetch --quiet "$REMOTE" "+refs/heads/staging:refs/remotes/$REMOTE/staging" 2>/dev/null; then
  staging_sha=$(git rev-parse "$REMOTE/staging")
  discarded=$(git log --oneline --no-merges "$REMOTE/main..$staging_sha")
  if [[ -n "$discarded" ]]; then
    echo "Commits em staging que não estão em main e serão descartados:"
    echo "$discarded"
  fi
fi

if ! $yes; then
  [[ -t 0 ]] || fail "sem terminal para confirmar; use --yes"
  read -r -p "Resetar staging para main ($(git rev-parse --short "$REMOTE/main"))? [s/N] " answer
  [[ "$answer" =~ ^[sSyY]$ ]] || fail "cancelado"
fi

git push --quiet --force-with-lease="staging:$staging_sha" "$REMOTE" "$REMOTE/main:refs/heads/staging"
echo "staging resetada para main ($(git rev-parse --short "$REMOTE/main"))"
